# MongoDB Configuration
# Copy this file to .env.local and update with your MongoDB connection string

# For local MongoDB
MONGODB_URI=mongodb://localhost:27017/irrigation-test

# For MongoDB Atlas (replace with your actual connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/irrigation-system?retryWrites=true&w=majority

# JWT Secret (change this in production)
JWT_SECRET=your_jwt_secret_change_this_in_production

# Next.js Environment
NODE_ENV=development